      "type": "table",
      "title": "Revenue totals — sources currently MISSING",
      "description": "Any row here means the revenue total above is PARTIAL and understated. An empty table means every live revenue source was read. Sources that are merely not-configured are excluded on purpose: they are unwired features, not missing data.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "all live sources reporting",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fairwins_finops_source_configured{kind=\"revenue\",status=\"live\"} == 1 unless on(source) fairwins_finops_source_up == 1"
