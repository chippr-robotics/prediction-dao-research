/**
 * Production environment (spec 085).
 *
 * ⚠ THE GCP PROJECT IS SHARED. `chippr-bots-site-wp` hosts a public WordPress VM on the default
 * network plus the clearpath-*, fukuii-* and kings-edge-* workloads. Nothing here may describe,
 * reference, or authoritatively overwrite anything outside this project's own inventory
 * (data-model.md). Every IAM grant is additive (`*_iam_member`); the `_binding` and `_policy` forms
 * are rejected by `npm run check:iac` and are also outside the CI identity's permissions.
 *
 * Adoption is by the `import` blocks in imports.tf. A surface is DONE when `terraform plan` reports
 * no changes for it — if a plan is not clean, the CONFIGURATION is wrong, and it is fixed in this
 * repository. Never apply to force live infrastructure to match a generated body.
 */

# ── inputs that must stay fresh ────────────────────────────────────────────────────────────────

/**
 * Cloudflare's published egress ranges, re-read on every plan. A pinned stale copy either blocks
 * legitimate edge traffic or leaves the origin reachable by ranges Cloudflare has released; as a
 * data source, a change surfaces as a reviewable firewall diff instead (FR-040).
 */
data "cloudflare_ip_ranges" "cloudflare" {}

/**
 * Google's uptime prober addresses. No Terraform data source exists, so the list is generated by
 * `node scripts/infra/generate-prober-cidrs.js` and committed. The drift job re-runs the generator
 * and fails if the committed copy is stale — which is how staleness is made loud rather than
 * silently wrong.
 */
locals {
  prober_data  = jsondecode(file("${path.module}/prober-cidrs.json"))
  prober_cidrs = local.prober_data.cidrs
}

# ── network ───────────────────────────────────────────────────────────────────────────────────

module "network" {
  source = "../../modules/network"

  project_id   = var.project_id
  region       = var.region
  network_name = "fairwins-infra"
  subnet_name  = "fairwins-infra-usc1"
  subnet_cidr  = "10.10.0.0/24"

  # The live rules are `fairwins-allow-*`, NOT `fairwins-infra-allow-*`. Stated explicitly because a
  # derived name would not match what exists, and on import that reads as "create a new rule and
  # leave the old one" — in a firewall, both rules then stay in force.
  firewall_name_prefix = "fairwins"

  static_ip_names = ["fairwins-bundler-ip", "fairwins-gateway-ip"]

  cloudflare_ipv4_ranges = data.cloudflare_ip_ranges.cloudflare.ipv4_cidrs
  cloudflare_ipv6_ranges = data.cloudflare_ip_ranges.cloudflare.ipv6_cidrs
  uptime_prober_cidrs    = local.prober_cidrs
}

# ── nodes ─────────────────────────────────────────────────────────────────────────────────────

/**
 * Bundler. Runs alto (ERC-4337) behind the origin-lock nginx.
 *
 * It gets a DEDICATED, minimal service account. It previously ran as the default compute account,
 * which holds roles/editor — and editor includes iam.serviceAccountKeys.create and
 * serviceAccounts.actAs, so a container escape on the bundler could mint a key for the gateway's
 * account and sign with the paymaster HSM key. This grant is strictly smaller.
 */
module "bundler" {
  source = "../../modules/edge-node"

  project_id        = var.project_id
  region            = var.region
  zone              = var.zone
  name              = "fairwins-bundler"
  role              = "bundler"
  subnet_id         = module.network.subnet_id
  static_ip_address = module.network.static_ips["fairwins-bundler-ip"]

  create_service_account       = true
  service_account_id           = "fairwins-bundler"
  service_account_display_name = "FairWins alto bundler (VM)"
  service_account_description  = "Minimal: read two secrets, pull images, write logs/metrics. No project-level editor."

  secret_accessor_secrets      = ["alto-executor-key-137", "origin-lock-secret"]
  artifact_registry_repository = var.artifact_registry_repository

  # run.viewer is required by single-alto-gate.sh, which must be able to read whether a Cloud Run
  # bundler is armed and FAILS CLOSED when it cannot — without it the VM's alto can never start. It
  # must be project-level: gcloud reports a genuine 404 and a permission denial identically, and a
  # service-scoped binding disappears with the service at decommission, leaving the gate unable to
  # tell "deleted" from "forbidden" exactly when it matters.
  project_roles = [
    "roles/run.viewer",
    "roles/logging.logWriter",
    "roles/monitoring.metricWriter",
  ]

  startup_script = file("${path.module}/../../../vm/startup.sh")
}

/**
 * Gateway. Runs the relay/paymaster policy gateway, the OZ Relayer engine, and redis.
 *
 * It KEEPS `fairwins-relay-engine@`, which holds ZERO project-level roles today apart from
 * telemetry. That property is worth preserving, which is why its Artifact Registry grant is
 * repository-scoped and its secret access is per-secret.
 */
module "gateway" {
  source = "../../modules/edge-node"

  project_id        = var.project_id
  region            = var.region
  zone              = var.zone
  name              = "fairwins-gateway"
  role              = "gateway"
  subnet_id         = module.network.subnet_id
  static_ip_address = module.network.static_ips["fairwins-gateway-ip"]

  create_service_account = false
  service_account_email  = var.gateway_service_account_email

  secret_accessor_secrets      = var.gateway_secret_ids
  artifact_registry_repository = var.artifact_registry_repository

  project_roles = [
    "roles/logging.logWriter",
    "roles/monitoring.metricWriter",
  ]

  startup_script = file("${path.module}/../../../vm/startup.sh")
}

# ── secret containers ─────────────────────────────────────────────────────────────────────────
#
# CONTAINERS AND ACCESS ONLY. `google_secret_manager_secret_version` is forbidden (guardrail G-04):
# declaring a version writes the payload into state in plaintext. Payloads are created and rotated
# out of band, which is unchanged by this feature.

resource "google_secret_manager_secret" "managed" {
  for_each = toset(var.managed_secret_ids)

  project   = var.project_id
  secret_id = each.value

  replication {
    auto {}
  }

  # Destroying a container destroys every version it holds.
  lifecycle {
    prevent_destroy = true
  }
}

# ── artifact registry ─────────────────────────────────────────────────────────────────────────

resource "google_artifact_registry_repository" "cloud_run_source_deploy" {
  project       = var.project_id
  location      = var.region
  repository_id = var.artifact_registry_repository
  format        = "DOCKER"
  description   = "Images for Cloud Run services and the VM container stacks."

  lifecycle {
    prevent_destroy = true
  }
}

# ── KMS ───────────────────────────────────────────────────────────────────────────────────────
#
# Imported for the audit record and for their IAM bindings. Key VERSIONS are never managed: a
# destroyed version is unrecoverable, and state restore cannot bring it back.

resource "google_kms_key_ring" "signing" {
  count = var.kms_key_ring == null ? 0 : 1

  project  = var.project_id
  name     = var.kms_key_ring
  location = var.region

  lifecycle {
    prevent_destroy = true
  }
}

resource "google_kms_crypto_key" "signing" {
  for_each = var.kms_key_ring == null ? toset([]) : toset(var.kms_crypto_keys)

  name     = each.value
  key_ring = google_kms_key_ring.signing[0].id
  purpose  = "ASYMMETRIC_SIGN"

  version_template {
    algorithm = var.kms_signing_algorithm
  }

  lifecycle {
    prevent_destroy = true
  }
}

# ── Cloud Run ─────────────────────────────────────────────────────────────────────────────────
#
# SHAPE ONLY. Cloud Build owns the image tag and the revision identity (contracts/ownership-boundary.md).
#
# The decommissioned alto bundler service is deliberately NOT declared here. Re-arming it would put
# two executors on ONE EOA — colliding nonces, stuck bundles, both instances reporting healthy, and
# no in-band detection. Guardrail G-11 rejects any attempt to add it back.

module "spa" {
  source = "../../modules/cloud-run-service"

  project_id = var.project_id
  region     = var.region
  name       = "prediction-dao-research"

  # Required by the provider, then ignored. The pipeline publishes :latest alongside the SHA tag.
  image = "${var.region}-docker.pkg.dev/${var.project_id}/${var.artifact_registry_repository}/prediction-dao-research/prediction-dao-research:latest"

  min_instances         = 0
  max_instances         = 100
  cpu                   = "1"
  memory                = "512Mi"
  cpu_idle              = true
  allow_unauthenticated = true

  secret_env = var.spa_secret_env
}

# ── edge ──────────────────────────────────────────────────────────────────────────────────────

/**
 * The origin-lock header value.
 *
 * ACCEPTED EXCEPTION (plan.md Complexity Tracking): data-source results ARE written to state, so
 * this value lands there. `sensitive = true` hides a value from OUTPUT, not from state. The
 * alternative — a placeholder plus a manual dashboard step — reintroduces exactly the manual drift
 * this feature exists to remove. The state bucket's access is restricted accordingly (FR-010), and
 * this is a shared header secret, not a signing key.
 */
data "google_secret_manager_secret_version" "origin_lock" {
  count = var.manage_edge ? 1 : 0

  project = var.project_id
  secret  = "origin-lock-secret"
}

module "edge" {
  count  = var.manage_edge ? 1 : 0
  source = "../../modules/cloudflare-zone"

  zone_id = var.cloudflare_zone_id

  dns_records = [
    {
      name    = "bundler"
      type    = "A"
      value   = module.network.static_ips["fairwins-bundler-ip"]
      proxied = true
      comment = "Managed by Terraform (spec 085). Wired from the reserved address, so DNS cannot desync from the origin."
    },
    {
      name    = "relay"
      type    = "A"
      value   = module.network.static_ips["fairwins-gateway-ip"]
      proxied = true
      comment = "Managed by Terraform (spec 085)."
    },
  ]

  geo_gate_allowed_countries = var.geo_gate_allowed_countries
  geo_gate_response_code     = 451

  origin_lock_header_name = "X-Origin-Auth"
  origin_lock_secret      = data.google_secret_manager_secret_version.origin_lock[0].secret_data
}

# ── monitoring ────────────────────────────────────────────────────────────────────────────────

module "monitoring" {
  source = "../../modules/monitoring"

  project_id          = var.project_id
  notification_emails = var.notification_emails

  uptime_targets = [
    {
      name         = "bundler"
      display_name = "FairWins bundler origin"
      host         = module.network.static_ips["fairwins-bundler-ip"]
      path         = "/__probe/health"

      # A plain 200 proves NOTHING: the origin-lock nginx's own /healthz is a static `return 200`
      # that never touches alto — exactly the check that stayed green through the 2026-07-12 outage.
      # 0x5FF137D4 is the EntryPoint v0.6 address prefix in an eth_supportedEntryPoints response.
      content_match  = "0x5FF137D4"
      request_method = "POST"
      body           = base64encode("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_supportedEntryPoints\",\"params\":[]}")

      # The origin serves a Cloudflare Origin CA certificate, deliberately not publicly trusted.
      validate_ssl = false
    },
    {
      name         = "gateway"
      display_name = "FairWins gateway origin"
      host         = module.network.static_ips["fairwins-gateway-ip"]
      path         = "/__probe/health"

      # Must NOT be "status":"ok" — the server returns that unconditionally even when every chain
      # is down.
      content_match = "\"rpc\":\"up\""
      validate_ssl  = false
    },
  ]

  vm_alert_policies = var.vm_alert_policies
}
