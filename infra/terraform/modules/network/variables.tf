variable "project_id" {
  description = "GCP project id."
  type        = string
}

variable "region" {
  description = "Region for the subnet and static addresses."
  type        = string
}

variable "network_name" {
  description = "Name of the custom-mode VPC. Also the prefix for every firewall rule."
  type        = string
}

variable "subnet_name" {
  description = "Name of the regional subnet."
  type        = string
}

variable "firewall_name_prefix" {
  description = "Prefix for firewall rule names. Defaults to network_name. Set explicitly when the live rules do not share the network's name — an unmatched name on import creates a SECOND rule and leaves the first in force."
  type        = string
  default     = null
}

variable "subnet_cidr" {
  description = "Subnet range."
  type        = string
  default     = "10.10.0.0/24"
}

variable "static_ip_names" {
  description = "Static external addresses to reserve. These are pinned in Cloudflare DNS and are prevent_destroy protected."
  type        = list(string)
}

variable "edge_target_tags" {
  description = "Network tags the ingress rules apply to."
  type        = list(string)
  default     = ["fairwins-edge"]
}

variable "cloudflare_ipv4_ranges" {
  description = "Cloudflare IPv4 egress ranges. Passed in from the cloudflare_ip_ranges data source so a range change surfaces as a reviewable diff rather than a silent outage."
  type        = list(string)
}

variable "cloudflare_ipv6_ranges" {
  description = "Cloudflare IPv6 egress ranges."
  type        = list(string)
}

variable "uptime_prober_cidrs" {
  description = "Google uptime prober addresses as /32 CIDRs. No Terraform data source exists; generated by scripts/infra/generate-prober-cidrs.js and staleness-gated by the drift job."
  type        = list(string)
}

variable "iap_forwarding_cidrs" {
  description = "IAP TCP forwarding ranges. Google publishes 35.235.240.0/20; it is a variable so a future change does not require editing the module."
  type        = list(string)
  default     = ["35.235.240.0/20"]
}
