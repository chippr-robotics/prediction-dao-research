# Managed by Ansible (spec 085). Do not edit on the node — changes are overwritten on the next run.
#
# Google uptime prober allowlist for the /__probe/ location. The SAME list backs the GCP firewall
# rule (module network, google_compute_firewall.allow_uptime_probers), generated by
# scripts/infra/generate-prober-cidrs.js. Two allowlists that must agree are two allowlists that
# will eventually disagree, unless they come from one file — this is that file.
{% for cidr in nginx_prober_cidrs %}
allow {{ cidr }};
{% endfor %}
deny all;
